# Frontend Component Patterns

React 19 component conventions for HeyForm monorepo.

## Component Structure

```typescript
// Standard pattern
import { FC } from 'react'
import { cn } from '@/utils'

export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
  size?: 'sm' | 'md' | 'lg'
  loading?: boolean
}

const ButtonComponent: FC<ButtonProps> = ({
  className,
  size = 'lg',
  loading,
  children,
  ...restProps
}) => {
  return (
    <button className={cn('base-classes', className)} {...restProps}>
      {children}
    </button>
  )
}

export const Button = ButtonComponent
```

**Conventions**:
- Use `FC<PropsType>` for functional components
- Export props interface: `export interface ComponentNameProps`
- Destructure props with defaults in signature
- Always spread `...restProps` to pass through HTML attributes
- Named exports (not default)

## TypeScript Patterns

### Props Interfaces

```typescript
// Extend HTML attributes
export interface InputProps extends Omit<InputHTMLAttributes<HTMLInputElement>, 'onChange'> {
  hasError?: boolean
  onChange?: (value: any) => void  // Custom signature
}

// Use global types (from vite-env.d.ts)
interface ModalProps extends DOMProps {  // Only children prop
  open?: boolean
}

interface BadgeProps extends ComponentProps {  // All HTML attributes
  color?: 'red' | 'blue' | 'green'
}
```

**Global Types**:
- `ComponentProps<E>` = `HTMLAttributes<E>` (all HTML attrs)
- `DOMProps<E>` = Only `children` prop
- `Any` = TypeScript `any`
- `AnyMap` = `Record<string, any>`

### Custom Refs

```typescript
// Expose custom ref interface
export interface InputRef {
  clear: () => void
  submit: () => void
}

export interface InputProps {
  ref?: Ref<InputRef>
}

const InputComponent: FC<InputProps> = ({ ref, ...props }) => {
  const inputRef = useRef<HTMLInputElement>(null)

  useImperativeHandle<InputRef, InputRef>(ref, () => ({
    clear: () => setValue(''),
    submit: () => onEnter?.(inputRef.current?.value)
  }), [])

  return <input ref={inputRef} {...props} />
}
```

## Component Composition

### Object.assign Pattern

```typescript
// Compose variants using Object.assign
const ButtonComponent: FC<ButtonProps> = ({ ... }) => { ... }

const GhostButton: FC<ButtonProps> = ({ className, ...props }) => (
  <ButtonComponent className={cn('border-input', className)} {...props} />
)

export const Button = Object.assign(ButtonComponent, {
  Ghost: GhostButton,
  Link: LinkButton
})

// Usage: <Button />, <Button.Ghost />, <Button.Link />
```

**Pattern**: Main component + variants as properties

## Styling with TailwindCSS

### cn() Utility

```typescript
// Import from utils
import { cn } from '@/utils'  // Combines clsx + tailwind-merge

// Basic usage
className={cn('base-classes', className)}

// Conditional classes
className={cn(
  'flex items-center',
  {
    'opacity-50': disabled,
    'bg-primary': isActive,
    '[&_[data-slot=button]]:opacity-0': loading  // Nested selectors
  },
  className  // User className always last
)}

// Responsive (mobile-first)
className="h-11 sm:h-10 data-[size=sm]:h-9"
```

**Rules**:
- Always use `cn()` for class merging
- Base classes first, conditions second, custom className last
- Use `data-*` attributes with Tailwind selectors

## React Hooks Patterns

```typescript
// useState with TypeScript
const [value, setValue] = useState<string>('')
const [state, setState] = useState<'idle' | 'pending' | 'success'>('idle')

// useCallback for event handlers
const handleChange = useCallback(
  (newValue: string) => {
    onChange?.(newValue)
  },
  [onChange]
)

// useMemo for expensive computations
const columns = useMemo(
  () => rawColumns.map(c => ({ _key: c.id, ...c })),
  [rawColumns]
)

// useEffect with cleanup
useEffect(() => {
  return () => cancel()
}, [])

// useRef for DOM and mutable values
const inputRef = useRef<HTMLInputElement>(null)
const lock = useRef(false)  // Mutable value (no re-render)
```

## Event Handlers

### Custom onChange

```typescript
// Extract value from event
export interface InputProps extends Omit<InputHTMLAttributes<HTMLInputElement>, 'onChange'> {
  onChange?: (value: any) => void
}

const InputComponent: FC<InputProps> = ({ onChange, type, ...props }) => {
  function handleChange(event: ChangeEvent<HTMLInputElement>) {
    let newValue = event.target.value

    // Type-specific processing
    if (type === 'number') {
      newValue = Number(newValue)
      if (helper.isNan(newValue)) return
    }

    onChange?.(newValue)
  }

  return <input onChange={handleChange} {...props} />
}
```

### Composition Events (IME)

```typescript
// Handle IME input (Chinese, Japanese, Korean)
const lock = useRef(false)

function handleCompositionStart() {
  lock.current = true
}

function handleCompositionEnd(event: CompositionEvent<HTMLInputElement>) {
  lock.current = false
  onChange?.(event.currentTarget.value)
}

function handleChange(event: ChangeEvent<HTMLInputElement>) {
  if (!lock.current) {
    onChange?.(event.target.value)
  }
}

return (
  <input
    onCompositionStart={handleCompositionStart}
    onCompositionEnd={handleCompositionEnd}
    onChange={handleChange}
  />
)
```

**Critical**: Always use composition lock to prevent duplicate onChange calls

### Keyboard Events

```typescript
function handleKeyDown(event: KeyboardEvent<HTMLInputElement>) {
  if (!lock.current && event.key === 'Enter') {
    onEnter?.(event.currentTarget.value)
  }
}
```

## Data Fetching

```typescript
// Async component with states
import { useRequest } from 'ahooks'

const SimpleForm: FC<SimpleFormProps> = ({ fetch, ...props }) => {
  const { loading, error, runAsync } = useRequest(fetch!, {
    manual: true
  })

  async function handleFinish(values: any) {
    await runAsync(values)
  }

  return (
    <Form onFinish={handleFinish} {...props}>
      {children}
      <Button type="submit" loading={loading}>Submit</Button>
      {error && !loading && (
        <div className="text-error text-sm" data-slot="form-error">
          {error.message}
        </div>
      )}
    </Form>
  )
}
```

**Pattern**: Use `useRequest` from `ahooks` for async operations

## Loading States

```typescript
// Loading prop with visual feedback
const ButtonComponent: FC<ButtonProps> = ({ loading, children, ...props }) => {
  return (
    <button
      className={cn({
        '[&_[data-slot=button]]:opacity-0': loading
      })}
      disabled={loading || disabled}
      {...props}
    >
      <div data-slot="button">{children}</div>
      {loading && (
        <div className="absolute inset-0 flex items-center justify-center">
          <Loader />
        </div>
      )}
    </button>
  )
}
```

