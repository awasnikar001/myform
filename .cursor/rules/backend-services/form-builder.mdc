## Variables

### Variable Management

**Pattern**: CRUD operations with immediate sync

```typescript
// ✅ Good: Variable operations
export function setVariables(state: IState, variables: Variable[] = []): IState {
  FormService.updateVariables(state.formId, variables)  // Immediate sync
  return { ...state, variables }
}

export function addVariable(state: IState, variable: Variable): IState {
  return setVariables(state, [...(state.variables || []), variable])
}

export function updateVariable(
  state: IState,
  { id, updates }: UpdateVariableAction['payload']
): IState {
  const variables = state.variables || []
  const index = variables.findIndex(v => v.id === id)
  if (index < 0) return state

  return setVariables(
    state,
    variables.map((v, i) => (i === index ? { ...v, ...updates } : v))
  )
}

export function deleteVariable(state: IState, { id }: DeleteVariableAction['payload']): IState {
  return setVariables(
    state,
    state.variables?.filter(v => v.id !== id)
  )
}
```

**Variable Conventions**:
- Variables sync immediately (not queued)
- Use `FormService.updateVariables()` for API call
- Variables can be string or number type
- Used in logic calculations and mentions

## Hidden Fields

### Hidden Field Management

**Pattern**: Similar to variables, immediate sync

```typescript
// ✅ Good: Hidden field operations
function setHiddenFields(state: IState, hiddenFields: HiddenField[] = []): IState {
  FormService.updateHiddenFields(state.formId, hiddenFields)  // Immediate sync
  return { ...state, hiddenFields }
}

export function createHiddenField(state: IState, hiddenField: HiddenField): IState {
  return setHiddenFields(state, [...(state.hiddenFields || []), hiddenField])
}

export function editHiddenField(state: IState, hiddenField: HiddenField): IState {
  const hiddenFields = state.hiddenFields || []
  const index = hiddenFields.findIndex(h => h.id === hiddenField.id)
  if (index < 0) return state

  return setHiddenFields(
    state,
    hiddenFields.map((h, i) => (i === index ? hiddenField : h))
  )
}
```

**Hidden Field Conventions**:
- Hidden fields sync immediately
- Used to pass data without showing fields
- Can be referenced in logic and mentions
- Simple structure: `{ id, name }`

## Publishing & Syncing

### Draft System

**Pattern**: Drafts stored separately from published fields

```typescript
// ✅ Good: Publishing with drafts
async function handlePublish() {
  const { fields } = getFilteredFields(state.fields!)
  
  await FormService.publishForm({
    formId,
    version: form!.version as number,
    drafts: fields
  })

  updateForm({ canPublish: false })
  router.push(`/workspace/${workspaceId}/project/${projectId}/form/${formId}/share`)
}
```

**Draft Conventions**:
- Drafts stored in `_drafts` field (JSON string)
- Published fields stored in `fields` array
- `canPublish` flag indicates if drafts differ from published
- Publishing copies drafts to fields
- Version increments on publish

### Sync Queue

**Pattern**: Debounced queue for field updates

```typescript
// ✅ Good: Sync queue implementation
export class Queue {
  private tasks: Task[] = []
  private version: number = 0
  private lastSyncedVersion: number = 0

  public add() {
    this.version += 1
    const task = { timestamp: Date.now(), version: this.version, status: Status.IDLE }
    
    if (this.tasks[0]?.status === Status.IDLE) {
      this.tasks[0] = task
    } else {
      this.tasks.unshift(task)
    }

    // Immediate sync if timeout exceeded
    if (Date.now() - this.lastSyncedAt > this.taskTimeout) {
      this.consume(task)
    }
  }

  private async consume(task: Task) {
    // Only sync latest version
    if (task.version < this.lastSyncedVersion) {
      return
    }

    this.tasks[index].status = Status.PENDING
    this.lastSyncedAt = Date.now()

    try {
      await this.syncFunction?.()
      if (task.version >= this.lastSyncedVersion) {
        this.lastSyncedVersion = task.version
      }
      this.remove(task.version)
      this.callback?.('complete', task)
    } catch (err) {
      this.update(task.version, { status: Status.FAILED })
      this.callback?.('failed', task, err as Error)
    }
  }
}
```

**Sync Queue Conventions**:
- Queue debounces field updates (2s default interval)
- Only latest version syncs (older versions skipped)
- Immediate sync if timeout exceeded (10s default)
- Status tracking: IDLE → PENDING → (complete/failed)
- Callbacks for start/complete/failed events

### Sync Integration

**Pattern**: Queue integration in compose component

```typescript
// ✅ Good: Queue setup in component
const queue = useRef(new Queue()).current

const sync = useCallback(async () => {
  try {
    const { fields } = getFilteredFields(state.fields!)
    const result = await FormService.updateFormSchemas({
      formId,
      version: form?.version as number,
      drafts: fields
    })
    updateForm(result)
  } catch (err: any) {
    toast({ title: t('components.error.title'), message: err.message })
  }
}, [formId, state.fields, form?.version])

queue.on(event => {
  switch (event) {
    case 'start':
      dispatch({ type: 'setSyncing', payload: { isSyncing: true } })
      queue.sync(sync)
      break
    case 'complete':
    case 'failed':
      dispatch({ type: 'setSyncing', payload: { isSyncing: false } })
      break
  }
})

useEffect(() => {
  if (state.version > 0) {
    queue.add()  // Trigger sync on version change
  }
}, [state.version])
```

**Sync Integration Conventions**:
- Create queue instance with `useRef`
- Sync function filters and serializes fields
- Queue callbacks update syncing state
- Version changes trigger queue.add()
- Cleanup queue on unmount

## Rich Text Editing

### RichText Component

**Pattern**: ContentEditable with mention and toolbar support

```typescript
// ✅ Good: RichText component
export const RichText: FC<RichTextProps> = ({
  innerRef,
  value,
  placeholder,
  onChange,
  ...restProps
}) => {
  const [keyword, setKeyword] = useState<string>()
  const [isMentionOpen, setIsMentionOpen] = useState(false)
  const [isToolbarOpen, setIsToolbarOpen] = useState(false)

  const handleUpdateCallback = useMemo(
    () => debounce(() => {
      onChange?.(innerRef.current!.innerHTML)
    }, 300),
    []
  )

  function handleMentionSelect(type: string, option: Partial<FormFieldType> | Variable) {
    const template = type === 'mention'
      ? `<span class="mention" data-mention="${option.id}" contenteditable="false">@${(option as FormFieldType).title}</span>\xA0`
      : `<span class="variable" data-variable="${option.id}" contenteditable="false">@${(option as Variable).name}</span>\xA0`

    replaceTriggerText(innerRef.current!, triggerSelection!, template)
    handleUpdateCallback()
    hideMentionMenu()
  }

  function handleKeyUp() {
    if (inputKey === MENTION_TRIGGER) {
      const selection = getTriggerSelection()
      setPortalStyle(getStyleFromRect(selection!.rect!))
      setIsMentionOpen(true)
      setTriggerSelection(selection)
    }
  }

  return (
    <>
      <div
        ref={innerRef}
        className="rich-text"
        contentEditable={true}
        onKeyUp={handleKeyUpCallback}
        onInput={handleInputCallback}
        onPaste={handlePasteCallback}
        onMouseUp={handleMouseUpCallback}
      />
      <MentionMenu visible={isMentionOpen} keyword={keyword} onComplete={handleMentionSelectCallback} />
      <FloatingToolbar visible={isToolbarOpen} range={toolbarRange} />
    </>
  )
}
```

**RichText Conventions**:
- Use `contentEditable` div (not textarea)
- Debounce onChange (300ms)
- Mention trigger: `@` character
- Mention spans: `data-mention` or `data-variable` attributes
- Floating toolbar for text selection
- Handle composition events for IME
- Custom paste handling

