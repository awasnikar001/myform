## Field Rendering

### Block Component Pattern

**Pattern**: Base Block component with field-specific blocks

```typescript
// ✅ Good: Block component structure
export const Block: FC<BlockProps> = ({
  field,
  locale,
  parentField,
  children,
  ...restProps
}) => {
  const { dispatch } = useStoreContext()
  const titleRef = useRef<HTMLDivElement>()
  const descriptionRef = useRef<HTMLDivElement>()

  const isLabelShow = QUESTION_FIELD_KINDS.includes(field.kind)
  const isCoverShow = helper.isValid(field.layout?.mediaUrl)

  function handleTitleChange(title: string) {
    dispatch({
      type: 'updateField',
      payload: { id: field.id, updates: { title } }
    })
  }

  return (
    <>
      <div className="heyform-theme-background" />
      {field.layout?.align !== FieldLayoutAlignEnum.INLINE && (
        <Layout layout={field.layout} />
      )}
      {parentField && (
        <div className="heyform-block-group">
          <label>{t('Question {{number}}', { number: questionNumber(parentField.index) })}</label>
          <div>{parentField.title}</div>
        </div>
      )}
      <div className="heyform-block-container">
        <div className="heyform-block">
          {isLabelShow && (
            <label className="heyform-block-number">
              {t('Question {{number}}', { number: questionNumber(field.index, parentField?.index) })}
              {field.validations?.required && <span className="text-error">*</span>}
            </label>
          )}
          <RichText
            className="heyform-block-title"
            innerRef={titleRef}
            placeholder={t('form.builder.compose.question')}
            onChange={handleTitleChangeCallback}
          />
          <RichText
            className="heyform-block-description"
            innerRef={descriptionRef}
            placeholder={t('form.builder.compose.description')}
            onChange={handleDescriptionChangeCallback}
          />
          {children}
        </div>
      </div>
    </>
  )
}
```

**Block Conventions**:
- Block wraps field-specific components
- Shows question number for question fields
- RichText for title and description
- Layout component for media/background
- Parent field context for nested fields
- Required indicator for required fields

### Field-Specific Blocks

**Pattern**: Switch statement for field rendering

```typescript
// ✅ Good: Field rendering switch
const Fields: FC = () => {
  const { state } = useStoreContext()
  const field = state.currentField

  if (!field) return null

  switch (field.kind) {
    case FieldKindEnum.ADDRESS:
