## Field Selection

### Selection Logic

**Pattern**: Track current and parent field

```typescript
// ✅ Good: Field selection
export function selectField(
  state: IState,
  { id: currentId, parentId }: SelectFieldAction['payload']
): IState {
  let currentField: FormFieldType | undefined
  let parentField: FormFieldType | undefined

  if (parentId) {
    parentField = state.fields.find(field => field.id === parentId)
    if (parentField) {
      const index = fieldIndex(parentField.properties?.fields, currentId)
      if (index > -1) {
        currentField = parentField.properties!.fields![index]
      } else {
        currentField = parentField
        parentField = undefined
      }
    }
  } else {
    currentField = state.fields.find(f => f.id === currentId)
  }

  const index = state.questions.findIndex(q => q.id === currentId)
  const references = index < 1 ? state.questions : state.questions.slice(0, index)

  return {
    ...state,
    currentId,
    parentId,
    currentField,
    parentField,
    references
  }
}
```

**Selection Conventions**:
- Track both currentField and parentField
- References are questions before current
- Used for mention system
- Update on field add/update/delete

## Logic Flow Visualization

### Flow Graph Generation

**Pattern**: Convert fields and logics to nodes/edges

```typescript
// ✅ Good: Logic flow visualization
export function fieldLogicToNodesEdges(
  rawFields: FormFieldType[],
  logics?: Logic[]
): { nodes: Node[]; edges: Edge[] } {
  const nodes: Node[] = []
  const edges: Edge[] = []
  const fields = flattenFieldsWithGroups(rawFields)

  // Create nodes for each field
  fields.forEach((field, index) => {
    nodes.push({
      id: field.id,
      type: 'customNode',
      data: { field, isFirstField: index === 0, isLastField: index === fields.length - 1 },
      position: { x: 0, y: 0 },
      connectable: true,
      selectable: !UNSELECTABLE_FIELD_KINDS.includes(field.kind)
    })

    // Create sequential edges
    if (index < fields.length - 1) {
      edges.push({
        id: `${field.id}-${fields[index + 1].id}`,
        source: field.id,
        target: fields[index + 1].id,
        style: { stroke: '#1f2937' },
        markerEnd: 'edge-marker-arrow'
      })
    }
  })

  // Create logic edges
  logics?.forEach(logic => {
    logic.payloads.forEach(payload => {
      if (payload.action.kind === ActionEnum.NAVIGATE) {
        edges.push({
          type: 'customEdge',
          id: payload.id,
          source: logic.fieldId,
          target: payload.action.fieldId,
          style: { stroke: '#1f2937' },
          markerEnd: 'edge-marker-arrow'
        })
      }
    })
  })

  return getLayoutedElements(nodes, edges)
}
```

**Flow Visualization Conventions**:
- Use dagre for automatic layout
- Sequential edges between fields
- Logic edges for NAVIGATE actions
- Custom node type for field display
- Unselectable fields: WELCOME, THANK_YOU, STATEMENT

## Field Kind Defaults

### Default Properties by Kind

**Pattern**: Kind-specific property initialization

```typescript
// ✅ Good: Field kind defaults
switch (kind) {
  case FieldKindEnum.MULTIPLE_CHOICE:
  case FieldKindEnum.PICTURE_CHOICE:
    field.properties!.allowMultiple = false
    field.properties!.verticalAlignment = true
    field.properties!.choices = [{ id: nanoid(12), label: '' }]
    break

  case FieldKindEnum.RATING:
    field.properties!.total = 5
    field.properties!.shape = 'star'
    break

  case FieldKindEnum.OPINION_SCALE:
    field.properties!.total = 10
    break

  case FieldKindEnum.YES_NO:
    field.properties!.choices = [
      { id: nanoid(12), label: 'Yes' },
      { id: nanoid(12), label: 'No' }
    ]
    break

  case FieldKindEnum.DATE:
  case FieldKindEnum.DATE_RANGE:
    field.properties!.format = 'MM/DD/YYYY'
    field.properties!.allowTime = false
    break

  case FieldKindEnum.PHONE_NUMBER:
    field.properties!.defaultCountryCode = 'US'
    break

  case FieldKindEnum.INPUT_TABLE:
    field.properties!.tableColumns = [
      { id: nanoid(12), label: '' },
      { id: nanoid(12), label: '' }
    ]
    break

  case FieldKindEnum.PAYMENT:
    field.properties!.currency = 'USD'
    field.properties!.price = { type: 'number', value: 0 }
    break

  case FieldKindEnum.GROUP:
    field.isCollapsed = false
    field.properties!.fields = [getFieldFromKind(FieldKindEnum.SHORT_TEXT)]
    break
}
```

**Default Conventions**:
- Set sensible defaults per field kind
- Use nanoid(12) for choice/column IDs
- Initialize with minimal required structure
- GROUP fields start with one nested field

## Field Validation

### Validation Structure

**Pattern**: Field-level validation rules

```typescript
// ✅ Good: Validation structure
interface Validation {
  required?: boolean
  min?: number
  max?: number
  matchExpected?: boolean
}

function sanitizeValidations(validations?: Validation): Validation | undefined {
  if (!validations) return undefined

  const { required, min, max, matchExpected } = validations
  const cleaned: Validation = {}

  if (typeof required !== 'undefined') cleaned.required = required
  if (typeof min !== 'undefined') cleaned.min = min
  if (typeof max !== 'undefined') cleaned.max = max
  if (typeof matchExpected !== 'undefined') cleaned.matchExpected = matchExpected

  return Object.keys(cleaned).length > 0 ? cleaned : undefined
}
```

**Validation Conventions**:
- Only include defined validation properties
- Remove undefined/null values
- Return undefined if no validations
- Validate on form submission (not in builder)

