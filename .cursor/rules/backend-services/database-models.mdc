## Service Layer Operations

### Model Injection

```typescript
import { Injectable } from '@nestjs/common'
import { InjectModel } from '@nestjs/mongoose'
import { Model } from 'mongoose'
import { FormModel } from '@model'

@Injectable()
export class FormService {
  constructor(
    @InjectModel(FormModel.name)
    private readonly formModel: Model<FormModel>
  ) {}
}
```

### Query Operations

```typescript
// Find by ID
async findById(id: string): Promise<FormModel | null> {
  return this.formModel.findById(id)
}

// Find one with conditions
async findByIdInTeam(id: string, teamId: string) {
  return this.formModel.findOne({ _id: id, teamId })
}

// Find all with $in
async findAllInTeam(teamIds: string[]): Promise<FormModel[]> {
  return this.formModel.find({
    teamId: { $in: teamIds }
  })
}

// Find with sort and limit
async findRecent(teamId: string, limit = 10): Promise<FormModel[]> {
  return this.formModel
    .find({ teamId, status: FormStatusEnum.NORMAL })
    .sort({ updatedAt: -1 })
    .limit(limit)
}

// Search with regex
async search(teamId: string, keyword: string): Promise<FormModel[]> {
  return this.formModel.find({
    teamId,
    name: new RegExp(keyword, 'i')  // Case-insensitive
  }).sort({ updatedAt: -1 })
}

// Count
async count(teamId: string): Promise<number> {
  return this.formModel.countDocuments({ teamId })
}

// Aggregation
async countByProject(projectIds: string[]) {
  return this.formModel.aggregate<FormModel>([
    { $match: { projectId: { $in: projectIds } } },
    { $group: { _id: '$projectId', count: { $sum: 1 } } }
  ]).exec()
}
```

### Create Operations

```typescript
// Create and return ID
async create(data: Partial<FormModel>): Promise<string> {
  const form = new this.formModel(data)
  await form.save()
  return form.id
}

// Create with defaults
async create(input: CreateFormInput, teamId: string): Promise<string> {
  return await this.formService.create({
    teamId,
    fields: [],
    settings: {
      active: false,
      captchaKind: CaptchaKindEnum.NONE
    },
    ...input
  })
}
```

### Update Operations

```typescript
// Update by ID
async update(id: string, updates: Partial<FormModel>): Promise<void> {
  await this.formModel.findByIdAndUpdate(id, updates)
}

// Update many
async updateMany(teamId: string, updates: Partial<FormModel>): Promise<void> {
  await this.formModel.updateMany({ teamId }, updates)
}
```

### Delete Operations

```typescript
// Hard delete
async delete(id: string): Promise<void> {
  await this.formModel.findByIdAndDelete(id)
}

// Soft delete (status update)
async moveToTrash(id: string): Promise<void> {
  await this.formModel.findByIdAndUpdate(id, {
    status: FormStatusEnum.TRASH,
    retentionAt: timestamp()
  })
}

// Find trash items
async findAllInTrash(): Promise<FormModel[]> {
  return this.formModel.find({
    retentionAt: { $lte: timestamp(), $gt: 0 },
    status: FormStatusEnum.TRASH
  })
}
```

## MongoDB Configuration

```typescript
// packages/server/src/config/mongo/
export class MongoService implements MongooseOptionsFactory {
  createMongooseOptions(): MongooseModuleOptions {
    const options: MongooseModuleOptions = {
      uri: MONGO_URI,
      user: MONGO_USER,
      pass: MONGO_PASSWORD
      // No deprecated options (v6+)
    }

    if (MONGO_SSL_CA_PATH) {
      options.sslCA = MONGO_SSL_CA_PATH as any
    }

    return options
  }
}
```

